# Copy to .env for local dev. In production (Railway), set these as service
# environment variables instead — do NOT commit a real .env.

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT secret (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-random-secret

# Login allowlist: comma-separated emails and/or domains (domains start with @).
# Only these accounts can log in. If empty, ALL logins are rejected (fail closed).
# Example: ALLOWED_EMAILS=alice@gmail.com,@mycompany.com
ALLOWED_EMAILS=

# SQLite path (local dev default)
DATABASE_PATH=./data/yearly.db

# Port
PORT=3001
